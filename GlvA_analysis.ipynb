    "# Обрабатываем Раунд Б с прогресс-баром\n",
    "if hb_round_B.results.hbonds is not None and len(hb_round_B.results.hbonds) > 0:\n",
    "    for bond in tqdm(hb_round_B.results.hbonds, desc=\"Парсинг Раунда Б\"):\n",
