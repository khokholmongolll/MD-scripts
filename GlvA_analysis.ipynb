   "source": [
    "import __main__\n",
    "__main__.pymol_argv = ['pymol', '-x']\n",
    "import pymol\n",
    "pymol.finish_launching()\n",
    "from pymol import cmd\n",
    "cmd.do('load trajectory.pdb, my_traj')\n",
    "cmd.do('remove solvent and not resi 3846')\n",
    "cmd.do('delete all')\n",
    "cmd.do('load trajectory_no_h20.pdb, my_traj')"
   ]
